local optToken = 0
local saved = {}
local optConns = {}
local origQuality

local TRANSPARENT = {
	Decal = true,
	Texture = true,
}

local CLEAR = {
	Shirt = {"ShirtTemplate"},
	Pants = {"PantsTemplate"},
	ShirtGraphic = {"Graphic"},
	SurfaceAppearance = {"ColorMap", "MetalnessMap", "NormalMap", "RoughnessMap"},
	SpecialMesh = {"TextureId"},
}

local DISABLE = {
	ParticleEmitter = true,
	Trail = true,
	Beam = true,
	Fire = true,
	Smoke = true,
	Sparkles = true,
	BloomEffect = true,
	BlurEffect = true,
	DepthOfFieldEffect = true,
	SunRaysEffect = true,
}

local function setProp(inst, prop, value)
	local s = saved[inst]
	if not s then
		s = {}
		saved[inst] = s
	end
	if s[prop] == nil then
		s[prop] = inst[prop]
	end
	inst[prop] = value
end

local function trySet(inst, prop, value)
	pcall(setProp, inst, prop, value)
end

local function optimizeInstance(inst)
	pcall(function()
		if inst:IsA("Terrain") then
			return
		end

		local class = inst.ClassName

		if TRANSPARENT[class] then
			setProp(inst, "Transparency", 1)
		elseif CLEAR[class] then
			for _, prop in ipairs(CLEAR[class]) do
				trySet(inst, prop, "")
			end
		elseif DISABLE[class] then
			setProp(inst, "Enabled", false)
		elseif inst:IsA("BasePart") then
			setProp(inst, "Material", Enum.Material.SmoothPlastic)
			setProp(inst, "Reflectance", 0)
			setProp(inst, "CastShadow", false)
			if inst:IsA("MeshPart") then
				trySet(inst, "TextureID", "")
				trySet(inst, "RenderFidelity", Enum.RenderFidelity.Performance)
			end
		end
	end)
end

local function restoreAll()
	for inst, props in pairs(saved) do
		for prop, value in pairs(props) do
			pcall(function()
				inst[prop] = value
			end)
		end
	end
	saved = {}
end

local function setOptimization(state)
	optToken += 1
	local token = optToken

	for _, c in ipairs(optConns) do
		c:Disconnect()
	end
	table.clear(optConns)

	if state then
		trySet(Lighting, "GlobalShadows", false)
		local terrain = workspace:FindFirstChildOfClass("Terrain")
		if terrain then
			trySet(terrain, "Decoration", false)
			trySet(terrain, "WaterWaveSize", 0)
			trySet(terrain, "WaterReflectance", 0)
		end

		pcall(function()
			local rendering = settings().Rendering
			origQuality = rendering.QualityLevel
			rendering.QualityLevel = Enum.QualityLevel.Level01
		end)

		table.insert(optConns, workspace.DescendantAdded:Connect(optimizeInstance))
		table.insert(optConns, Lighting.DescendantAdded:Connect(optimizeInstance))

		task.spawn(function()
			local n = 0
			for _, inst in ipairs(workspace:GetDescendants()) do
				if token ~= optToken then
					return
				end
				optimizeInstance(inst)
				n += 1
				if n % 300 == 0 then
					task.wait()
				end
			end
			for _, inst in ipairs(Lighting:GetDescendants()) do
				optimizeInstance(inst)
			end
		end)
	else
		restoreAll()

		if origQuality then
			pcall(function()
				settings().Rendering.QualityLevel = origQuality
			end)
		end
	end
end

