local function getAimPart(character)
	if cfg.aimPart == 1 then
		return character:FindFirstChild("Head")
	end
	return character:FindFirstChild("UpperTorso")
		or character:FindFirstChild("Torso")
		or character:FindFirstChild("HumanoidRootPart")
end

local function isVisible(part, character)
	local cam = workspace.CurrentCamera
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {localPlayer.Character, character}
	params.IgnoreWater = true
	local origin = cam.CFrame.Position
	local result = workspace:Raycast(origin, part.Position - origin, params)
	return result == nil
end

local function getAimTarget()
	local cam = workspace.CurrentCamera
	if not cam then
		return nil
	end

	local mouse = UserInputService:GetMouseLocation()
	local bestPos, bestDist

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= localPlayer then
			local sameTeam = player.Team ~= nil and player.Team == localPlayer.Team
			if not (cfg.aimTeam and sameTeam) then
				local character = player.Character
				local hum = character and character:FindFirstChildOfClass("Humanoid")
				local part = character and getAimPart(character)
				if hum and hum.Health > 0 and part then
					local pos = part.Position
					if cfg.aimPred > 0 then
						pos += part.AssemblyLinearVelocity * cfg.aimPred
					end
					local screen, onScreen = cam:WorldToViewportPoint(pos)
					if onScreen then
						local dist = (Vector2.new(screen.X, screen.Y) - mouse).Magnitude
						if dist <= cfg.aimRadius and (not bestDist or dist < bestDist) then
							if not cfg.aimWall or isVisible(part, character) then
								bestPos = pos
								bestDist = dist
							end
						end
					end
				end
			end
		end
	end

	return bestPos
end

RunService:BindToRenderStep("SkorlypaAim", Enum.RenderPriority.Camera.Value + 1, function()
	local cam = workspace.CurrentCamera

	if cfg.aim and cfg.aimShowFov then
		local m = UserInputService:GetMouseLocation()
		fovCircle.Size = UDim2.fromOffset(cfg.aimRadius * 2, cfg.aimRadius * 2)
		fovCircle.Position = UDim2.fromOffset(m.X, m.Y)
		fovCircle.Visible = true
	else
		fovCircle.Visible = false
	end

	if not cfg.aim or not cam then
		return
	end
	if not aimActive() then
		return
	end

	local target = getAimTarget()
	if not target then
		return
	end

	local goal = CFrame.lookAt(cam.CFrame.Position, target)
	local alpha = 1 / math.max(cfg.aimSmooth, 1)
	cam.CFrame = cam.CFrame:Lerp(goal, alpha)
end)

