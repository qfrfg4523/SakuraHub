		s.Thickness = 2
		s.Color = Color3.new(1, 1, 1)
		s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		s.Transparency = 1
		s.Parent = b
		gradient(s, 45)
		strokes[i] = s

		b.MouseButton1Click:Connect(function()
			mark(i)
			onPick(i)
		end)
	end

	mark(initial or 1)
end

