local function selectTab(index)
	currentTab = index
	for i, p in ipairs(pages) do
		p.Visible = (i == index)
	end
	for i, t in ipairs(tabButtons) do
		local on = (i == index)
		tween(t.button, 0.15, {
			BackgroundTransparency = on and 0.3 or 1,
			TextColor3 = on and COLORS.text or COLORS.sub,
		})
		t.indicator.Visible = on
	end
	pageTitle.Text = tr(tabNames[index])
end

