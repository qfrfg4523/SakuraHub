local function updatePlayer(player)
	if player == localPlayer then
		return
	end
	local character = player.Character

	if hlOn and character then
		local h = highlights[player]
		if not h or h.Parent ~= character then
			if h then
				h:Destroy()
			end
			h = Instance.new("Highlight")
			h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			h.Adornee = character
			h.Parent = character
			highlights[player] = h
		end
		h.FillColor = hlColor
		h.OutlineColor = hlColor
		h.FillTransparency = hlTransparency
	elseif highlights[player] then
		highlights[player]:Destroy()
		highlights[player] = nil
	end

	local head = character and character:FindFirstChild("Head")
	if tagsOn and head then
		local tag = nameTags[player]
		if not tag or tag.Parent ~= head then
			if tag then
				tag:Destroy()
			end
			tag = Instance.new("BillboardGui")
			tag.Name = "NameTag"
			tag.Size = UDim2.new(0, 160, 0, 26)
			tag.StudsOffset = Vector3.new(0, 2.6, 0)
			tag.AlwaysOnTop = true
			tag.MaxDistance = math.huge
			tag.Adornee = head
			tag.Parent = head

			local l = Instance.new("TextLabel")
			l.Size = UDim2.new(1, 0, 1, 0)
			l.BackgroundTransparency = 1
			l.Text = player.Name
			l.TextColor3 = Color3.new(1, 1, 1)
			l.TextStrokeColor3 = Color3.new(0, 0, 0)
			l.TextStrokeTransparency = 0.2
			l.Font = Enum.Font.GothamBold
			l.TextSize = 16
			l.Parent = tag

			nameTags[player] = tag
		end
	elseif nameTags[player] then
		nameTags[player]:Destroy()
		nameTags[player] = nil
	end
end

local function refreshAll()
	for _, player in ipairs(Players:GetPlayers()) do
