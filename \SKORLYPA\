local function numberOr(v, lo, hi, default)
	if type(v) == "number" then
		return math.clamp(v, lo, hi)
	end
	return default
end

local function loadSettings()
	local ok, data = pcall(function()
		if isfile and readfile and isfile(SETTINGS_FILE) then
			return HttpService:JSONDecode(readfile(SETTINGS_FILE))
		end
		return nil
	end)
	if not ok or type(data) ~= "table" then
		return
	end

	cfg.lang = (data.lang == "en") and "en" or "ru"
	cfg.hl = data.hl == true
	cfg.tags = data.tags == true
	cfg.color = math.floor(numberOr(data.color, 1, #SWATCHES, 1))
	cfg.trans = numberOr(data.trans, 0, 1, 0.5)
	cfg.sky = math.floor(numberOr(data.sky, 1, #SKIES, 1))
	cfg.time = numberOr(data.time, 0, 24, nil)
	cfg.bright = numberOr(data.bright, 0, 5, nil)
	cfg.fly = numberOr(data.fly, 10, 200, 60)
	cfg.walk = numberOr(data.walk, 16, 100, nil)
	cfg.opt = data.opt == true
	cfg.aim = data.aim == true
	cfg.aimMode = math.floor(numberOr(data.aimMode, 1, 3, 1))
	cfg.aimShowFov = data.aimShowFov ~= false
	cfg.aimRadius = numberOr(data.aimRadius, 20, 400, 120)
	cfg.aimSmooth = numberOr(data.aimSmooth, 1, 20, 5)
	cfg.aimPred = numberOr(data.aimPred, 0, 0.3, 0)
	cfg.aimPart = math.floor(numberOr(data.aimPart, 1, 2, 1))
	cfg.aimWall = data.aimWall ~= false
	cfg.aimTeam = data.aimTeam == true
end

loadSettings()

local saveToken = 0
local function saveSettings()
	saveToken += 1
	local token = saveToken
	task.delay(0.5, function()
		if token ~= saveToken then
			return
		end
		pcall(function()
			if writefile then
				writefile(SETTINGS_FILE, HttpService:JSONEncode(cfg))
			end
		end)
	end)
end

