local function makeToggle(page, title, sub, default, callback)
	local row = Instance.new("TextButton")
	row.Size = UDim2.new(1, -8, 0, 62)
	row.BackgroundColor3 = COLORS.card
	row.BackgroundTransparency = T.card
	row.Text = ""
	row.AutoButtonColor = false
	row.LayoutOrder = nextOrder(page)
	row.Parent = page
	round(row, 12)
	addHover(row, COLORS.card, COLORS.cardHover)

	label(row, title, 15, Enum.Font.GothamBold, COLORS.text, 14, 11, 190, 22)
	label(row, sub, 12, Enum.Font.Gotham, COLORS.sub, 14, 33, 190, 18)

	local track = Instance.new("Frame")
	track.Size = UDim2.new(0, 50, 0, 26)
	track.Position = UDim2.new(1, -64, 0.5, -13)
	track.BackgroundColor3 = COLORS.off
	track.BorderSizePixel = 0
	track.Parent = row
	round(track, 13)

	local knob = Instance.new("Frame")
	knob.Size = UDim2.new(0, 20, 0, 20)
	knob.Position = UDim2.new(0, 3, 0.5, -10)
	knob.BackgroundColor3 = Color3.new(1, 1, 1)
	knob.BorderSizePixel = 0
	knob.Parent = track
	round(knob, 10)

	local state = default
	local function set(value, silent)
		state = value
		if value then
			tween(knob, 0.18, {Position = UDim2.new(1, -23, 0.5, -10)})
			tween(track, 0.18, {BackgroundColor3 = COLORS.on})
		else
			tween(knob, 0.18, {Position = UDim2.new(0, 3, 0.5, -10)})
			tween(track, 0.18, {BackgroundColor3 = COLORS.off})
		end
		if not silent then
			callback(value)
		end
	end

	row.MouseButton1Click:Connect(function()
		set(not state)
	end)

	set(default, true)
	return set
end

