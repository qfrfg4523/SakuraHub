local registry = {}
local applyLanguage

local function tr(text)
	if lang == "en" then
		return EN[text] or text
	end
	return text
end

local function reg(obj, text)
	registry[#registry + 1] = {obj = obj, text = text}
	obj.Text = tr(text)
end

local function round(obj, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	c.Parent = obj
	return c
end

local function gradient(parent, rotation)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(COLORS.accent, COLORS.accent2)
	g.Rotation = rotation or 0
	g.Parent = parent
	return g
end

local function gradientStroke(parent, thickness)
	local s = Instance.new("UIStroke")
	s.Thickness = thickness
	s.Color = Color3.new(1, 1, 1)
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
	gradient(s, 45)
	return s
end

local function tween(obj, time, props)
	local t = TweenService:Create(obj, TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
	t:Play()
	return t
end

local function addHover(button, normal, hover)
	button.MouseEnter:Connect(function()
		tween(button, 0.12, {BackgroundColor3 = hover})
	end)
	button.MouseLeave:Connect(function()
		tween(button, 0.12, {BackgroundColor3 = normal})
	end)
end

local function label(parent, text, size, font, color, x, y, w, h, align, static)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Text = text
	l.TextSize = size
	l.Font = font
	l.TextColor3 = color
	l.Position = UDim2.new(0, x, 0, y)
	l.Size = UDim2.new(0, w, 0, h)
	l.TextXAlignment = align or Enum.TextXAlignment.Left
	l.Parent = parent
	if not static and EN[text] then
		reg(l, text)
	end
	return l
end

